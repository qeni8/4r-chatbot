# --- LLM ---
# Gemini: faturalandırma AÇIK olmalı. Ücretsiz katmanın günlük kotası yoğun günde biter
# ve bot "yoğunluk" mesajına düşer. Bu hacimde gerçek maliyet ~$2-5/ay.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Kaliteden memnun kalınmazsa tek satır geçiş: LLM_PROVIDER=anthropic
# (pip install -e ".[anthropic]" gerekir)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Veritabanı ---
# SQLite tek dosya. Sunucu/kurulum gerektirmez; yol göreliyse proje köküne göre çözülür.
DB_PATH=data/4r_chatbot.db

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Prod'da ZORUNLU: boşsa webhook istekleri reddedilir.
WHATSAPP_APP_SECRET=

# --- Uygulama ---
APP_ENV=dev
LOG_LEVEL=info
# CORS: dev "*"; prod "https://4r.com.tr,https://www.4r.com.tr"
CORS_ORIGINS=*

# --- Devir bildirimi (ÖNEMLİ) ---
# Bot cevaplayamayınca "sizi yetkilimize aktarayım" diyor. Buraya bir kanal
# girilmezse o söz boşta kalır: talep yalnızca veritabanına yazılır, kimse haberdar olmaz.
# Her ikisi de VİRGÜLLE çoğaltılabilir — birden fazla kişiye aynı anda gider.
BILDIRIM_EPOSTA=lojistik@4r.com.tr
# ör: lojistik@4r.com.tr,info@4r.com.tr,mudur@4r.com.tr

# Telefon bildirimi WhatsApp üzerinden gider; WHATSAPP_ACCESS_TOKEN ayarlı olmalı.
# ör: 905321112233,905339998877
BILDIRIM_WHATSAPP=

# E-posta göndermek için kutunun SMTP bilgileri:
# ör. mail.4r.com.tr
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
# boşsa SMTP_USER kullanılır
SMTP_FROM=

# --- Yönetim paneli (/yonetim) ---
# Bekleyen talepler, müşteri iletişim bilgileri ve botun bilmediği konular buradan izlenir.
# Şifre boş bırakılırsa panel tamamen kapalıdır (kazara açık kalmasın).
YONETIM_KULLANICI=4r
YONETIM_SIFRE=

# --- Anti-spam / maliyet tavanı ---
DAILY_LIMIT=200           # tüm bot, günlük
SESSION_DAILY_LIMIT=25    # tek oturum, günlük
IP_DAILY_LIMIT=60         # tek IP, günlük (oturum kimliği taklit edilebilir)
BURST_LIMIT=5             # tek oturum, son 60 saniye

# --- Bakım (scripts/bakim.py — Windows'ta saat başı çalışır) ---
# Bot yanıt vermezse bildirim kanallarına uyarı gider; veritabanı günlük yedeklenir.
SAGLIK_URL=http://localhost:8000/health
YEDEK_SAKLAMA_GUN=14

# --- KVKK ---
# Konuşma logları kişisel veridir; bu yaştan eski kayıtlar açılışta silinir. 0 = kapalı.
LOG_SAKLAMA_GUN=180
