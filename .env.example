# --- Database ---
# Dev: lokal Docker (docker-compose up -d)
DATABASE_URL=postgresql://4r:4r_dev_pw@localhost:5432/4r_chatbot

# --- LLM ---
# Kıyaslama için ikisi de doldurulur; karardan sonra biri kalır.
ANTHROPIC_API_KEY=
LLM_MODEL_DEFAULT=claude-haiku-4-5-20251001
LLM_MODEL_HARD=claude-sonnet-4-6

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Embedding ---
# Karar: ücretsiz yerel model (sunucuda çalışır, API/hesap yok).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024

# --- WhatsApp (Meta Cloud API) — Adım 7 ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# --- App ---
APP_ENV=dev
LOG_LEVEL=info
# CORS: dev "*"; prod "https://4r.com.tr,https://www.4r.com.tr"
CORS_ORIGINS=*
